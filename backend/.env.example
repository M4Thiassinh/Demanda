# =============================================================
# Plantilla de variables de entorno — backend "Demanda"
# Copia este archivo a .env y completa los valores reales.
# =============================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=demanda_db

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:5173

# Correo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
EMAIL_FROM=Teja Market Sistema <tu-correo@gmail.com>
EMAIL_PRODUCCION=destino-produccion@ejemplo.cl
EMAIL_TEJAFOOD_UNIDO=jeanpaulgame@tejamarket.cl

# Contraseñas de acceso (paneles)
ADMIN_PASSWORD=cambia-esta-clave
MASTER_PASSWORD=cambia-esta-clave-maestra

# Integración KDS (Kitchen Manager) — envío del pedido unido Teja Food a la cocina
# La app KDS expone POST {KITCHEN_API_URL}/api/integrations/planificacion (header x-api-key)
KITCHEN_API_URL=https://kitchen-manager.ejemplo.cl
KITCHEN_API_KEY=REEMPLAZAR_CON_API_KEY_REAL

# Correo diario del pedido unido Teja Food a Jean (hora de Chile). Default 21:00.
TEJAFOOD_HORA_CORREO=21
TEJAFOOD_MIN_CORREO=0
